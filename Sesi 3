import geopandas as gpd
from shapely.geometry import Point, Polygon
import pandas as pd

# 1. Inisialisasi Data Geospasial Pohon Perkotaan (Point)
data_pohon = {
    'Tree_ID': [f"TREE-{i:03d}" for i in range(1, 6)],
    'Spesies': ['Mahoni', 'Angsana', 'Trembesi', 'Mahoni', 'Tabebuya'],
    'Diameter_cm': [45, 60, 120, 30, 85],
    'Kondisi': ['Sehat', 'Perlu Pemangkasan', 'Kritis', 'Sehat', 'Kritis'],
    'Longitude': [102.2651, 102.2683, 102.2710, 102.2630, 102.2695],
    'Latitude': [-3.7952, -3.7981, -3.8012, -3.7920, -3.7990]
}

df_pohon = pd.DataFrame(data_pohon)

# Konversi DataFrame menjadi GeoDataFrame
geometry_pohon = [Point(xy) for xy in zip(df_pohon['Longitude'], df_pohon['Latitude'])]
gdf_pohon = gpd.GeoDataFrame(df_pohon, geometry=geometry_pohon, crs="EPSG:4326")

print("=== 1. DATASET GEOSPASIAL ASET POHON KOTA ===")
print(gdf_pohon[['Tree_ID', 'Spesies', 'Kondisi', 'geometry']])

# 2. Analisis Buffer Risiko Keselamatan (Proyeksi Spasial)
# Mengubah sistem koordinat ke Proyeksi Meter (UTM Zone 48S untuk Bengkulu)
gdf_pohon_utm = gdf_pohon.to_crs(epsg=32748)

# Membuat Zona Resiko / Buffer 15 Meter di sekitar pohon kritis
gdf_pohon_kritis = gdf_pohon_utm[gdf_pohon_utm['Kondisi'] == 'Kritis'].copy()
gdf_pohon_kritis['Zona_Bahaya'] = gdf_pohon_kritis.geometry.buffer(15.0)

print("\n=== 2. HASIL ANALISIS ZONA BUFFER POHON KRITIS (UTM METER) ===")
for idx, row in gdf_pohon_kritis.iterrows():
    print(f"Pohon ID: {row['Tree_ID']} | Luas Zona Risiko Bahaya: {row['Zona_Bahaya'].area:.2f} m²")
